# ─── AI Providers ──────────────────────────────────────────────────────────────
# Groq API key (starts with gsk_) — preferred for fast LLaMA inference
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini fallback (optional)
# GEMINI_API_KEY=your_gemini_api_key_here

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
DB_NAME=spendwise_db
DB_USER=postgres
DB_PASS=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Change this to a long, random, secret string in production!
JWT_SECRET=replace_with_a_long_random_secret

# ─── App URL (for production/OAuth callbacks) ──────────────────────────────────
# APP_URL=https://your-deployed-app-url.com
